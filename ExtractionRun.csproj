<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Version>0.1.7</Version>
        <LangVersion>13.0</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!--
          Content is packaged as a multi-version variant (lib/<game>/ExtractionRun.Content.dll)
          behind the small ExtractionRun loader assembly. Keep the public namespace as ExtractionRun.
        -->
        <AssemblyName>ExtractionRun.Content</AssemblyName>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
        <!--
          The extraction modifier (ExtractionModifier) is not registered through RitsuLib's content registry, so its
          loc id is the base-game bare class-name slug EXTRACTION_MODIFIER (ModifierModel.Title reads
          'modifiers/EXTRACTION_MODIFIER.title'). modifiers.json uses that form. STS001/STS003 from the base-game
          Alchyr.Sts2.ModAnalyzers can still misfire on content registered by RitsuLib at runtime (which RitsuLib
          renames to MODID_CATEGORY_TYPENAME), so keep them suppressed.
        -->
        <NoWarn>$(NoWarn);MSB3270;STS001;STS003</NoWarn>
    </PropertyGroup>

    <!-- Match a plain development build to the installed game. Variant builds always pass VariantTarget explicitly. -->
    <PropertyGroup Condition="'$(VariantTarget)' == '' and Exists('$(Sts2Path)/release_info.json')">
        <InstalledSts2Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(Sts2Path)/release_info.json')), '&quot;version&quot;\s*:\s*&quot;v?([^&quot;]+)&quot;').Groups[1].Value)</InstalledSts2Version>
    </PropertyGroup>
    <PropertyGroup>
        <EffectiveVariantTarget Condition="'$(VariantTarget)' != ''">$(VariantTarget)</EffectiveVariantTarget>
        <EffectiveVariantTarget Condition="'$(EffectiveVariantTarget)' == ''">$(InstalledSts2Version)</EffectiveVariantTarget>
    </PropertyGroup>

    <!-- 0.111.0 added CardPlay to AbstractModel.ModifyDamageMultiplicative and replaced CardCreationOptions'
         custom-pool APIs with WithFilter. -->
    <PropertyGroup Condition="'$(EffectiveVariantTarget)' != '0.107.1'">
        <DefineConstants>$(DefineConstants);STS2_DAMAGE_HOOK_HAS_CARD_PLAY;STS2_CARD_CREATION_OPTIONS_HAS_WITH_FILTER</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Build the game-facing ExtractionRun.dll loader alongside the content. We do not
         reference its types (ReferenceOutputAssembly=false); the loader drives content
         via reflection + the ModTypes bridge. -->
    <ItemGroup>
        <ProjectReference Include="ExtractionRunCode\Loader\ExtractionRunCode.Loader.csproj"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*"/>
        <PackageReference Include="STS2.RitsuLib"  Version="0.5.12"/>
        <AdditionalFiles Include="ExtractionRun/localization/**/*.json"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="ExtractionRun/**"/>
        <EmbeddedResource Remove="ExtractionRun/**"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The loader is its own project (ExtractionRun.dll); keep it out of the content assembly. -->
        <Compile Remove="ExtractionRunCode/Loader/**"/>
        <EmbeddedResource Remove="ExtractionRunCode/Loader/**"/>
        <None Remove="ExtractionRunCode/Loader/**"/>
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
        <None Include="ExtractionRun.json"/>
        <None Include="project.godot"/>
        <None Include="ExtractionRun/**"/>
    </ItemGroup>

    <Target Name="CheckDependencyPaths">
        <Error
            Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
            Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
    </Target>

    <!--
      Deploys one content variant into <Mods>/ExtractionRun/lib/<version>/ plus the loader at the mod
      root. Empty $(VariantTarget) (plain `dotnet build`, the dev loop) auto-detects the installed game
      version from release_info.json; build-variants.ps1 passes an explicit VariantTarget per snapshot
      to assemble the full multi-version bundle. The .pck is version-independent and produced by `dotnet publish`.
    -->
    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent">
        <Message Text="Deploying ExtractionRun content variant + loader to mods folder." Importance="high" />
        <Copy SourceFiles="ExtractionRun.json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/tools/deploy-mod.ps1&quot; -ContentDll &quot;$(TargetPath)&quot; -LoaderDll &quot;$(MSBuildProjectDirectory)/ExtractionRunCode/Loader/bin/$(Configuration)/net9.0/ExtractionRun.dll&quot; -ModRoot &quot;$(ModsPath)$(MSBuildProjectName)&quot; -Sts2DataDir &quot;$(Sts2DataDir)&quot; -VariantTarget &quot;$(VariantTarget)&quot;" />
    </Target>

    <!--
      The mod ships a .pck containing localization JSON + mod_image.png. Godot must import images to .ctex before
      they load at runtime via res://. Use Godot's own headless export. Run `dotnet publish` to produce the .pck.
      Requires GodotPath (set in Directory.Build.props) and export_presets.cfg (preset "BasicExport").
    -->
    <Target Name="NeedGodotForPublish" BeforeTargets="Publish">
        <Error Text="Godot path must be set up before publishing; Godot not found at path '$(GodotPath)'. Check Directory.Build.props file."
               Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')" />
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="Exporting Godot .pck to mods folder" Importance="high" />
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              IgnoreExitCode="true" />
    </Target>
</Project>
